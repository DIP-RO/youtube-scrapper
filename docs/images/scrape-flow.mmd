flowchart TD
    Start["User calls<br/>scraper.get_video(url)"]
    Utils1["utils.py — Extract video ID,<br/>validate format"]
    Client1["client.py — Launch Chrome, navigate,<br/>capture DevTools logs, extract<br/>ytInitialPlayerResponse & ytcfg"]
    Parsing["parsing.py — Parse metadata,<br/>detect access blocks,<br/>extract API key & transcript endpoint"]
    Client2["client.py — Fetch transcript,<br/>comments (paginated),<br/>dislikes from RYD API"]
    Utils2["utils.py — Generate extractive<br/>summary from transcript"]
    Models["models.py — Assemble typed<br/>VideoResult, return to caller"]

    Start --> Utils1
    Utils1 --> Client1
    Client1 --> Parsing
    Parsing --> Client2
    Client2 --> Utils2
    Utils2 --> Models
